{
  "name": "dsh-desktop",
  "version": "0.1.1",
  "description": "DeepSeek Harness 桌面端 — 在空白电脑上一键运行的 dsh 封装",
  "main": "electron/main.js",
  "author": {
    "name": "dsh-desktop contributors",
    "email": "2822343002@users.noreply.github.com"
  },
  "homepage": "https://github.com/2822343002/dsh-desktop",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.dsh.desktop",
    "productName": "DeepSeek Harness Desktop",
    "copyright": "Copyright © 2026",
    "compression": "normal",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node-runtime",
        "to": "node-runtime",
        "filter": ["**/*"]
      },
      {
        "from": "../runtime",
        "to": "runtime",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.png"
    },
    "portable": {
      "splashImage": "build/splash.bmp"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Development",
      "icon": "build/icon.png"
    }
  }
}
