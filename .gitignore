# 开发工具链（portable node、脚本、密钥、日志）— 不入库
.tools/

# dsh 运行时 node_modules（由构建脚本重新生成，不入库）
runtime/node_modules/

# Electron 工程产物与内置运行时
dsh-desktop/node_modules/
dsh-desktop/dist/
dsh-desktop/out/
dsh-desktop/node-runtime/
dsh-desktop/.electron-*

# 系统与编辑器
Thumbs.db
.DS_Store
*.log

# 本地 agent 记忆/会话文件
.atomcode/

# 插件独立依赖（由各插件 npm install 生成）
plugins/*/node_modules/
plugins/*/lib/
